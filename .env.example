# ─── Server ────────────────────────────────────────────────────────────────
PORT=3070
NODE_ENV=development
# Public origin this server is reached at. Used to build absolute URLs
# (heatmap images, the upgrade links shown when a quota runs out).
PUBLIC_URL=http://localhost:3070

# ─── RankTitan backend ─────────────────────────────────────────────────────
# The MCP server never touches Postgres. It calls the Rank Titan API over the
# internal bridge, the same shared-secret pattern the GSC and GA4 guards use.
RANKTITAN_API_URL=http://localhost:3010
# `x-internal-api-key`, for /internal/* only. Must match INTERNAL_API_KEY on the
# Rank Titan side, exactly.
RANKTITAN_INTERNAL_API_KEY=
# `x-api-key`, for the data endpoints. This is Rank Titan's API_KEY_SECRET — a
# DIFFERENT value, read by a different guard. Sending the internal key to a data
# endpoint returns 401.
RANKTITAN_API_KEY=

# ─── Auth ──────────────────────────────────────────────────────────────────
# v1 authenticates with an API key the user copies from their dashboard.
# OAuth 2.1 implements the same Authenticator interface later; no tool changes.
AUTH_STRATEGY=api_key

# ─── Quotas ────────────────────────────────────────────────────────────────
# Free tier. The heatmap allowance is already here so the limit is a config
# change, not a code change, the day that tool ships.
QUOTA_FREE_HEATMAPS=1
QUOTA_FREE_REVIEW_REPLIES=unlimited
QUOTA_PAID_REVIEW_REPLIES=unlimited

# Upgrade links shown verbatim to the user inside the chat.
UPGRADE_URL=https://ranktitan.ai/pricing
BILLING_URL=https://ranktitan.ai/billing

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Protects the server. The quota above protects the business — different jobs.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_KEY=60
RATE_LIMIT_MAX_PER_IP=120

# ─── Usage and audit ───────────────────────────────────────────────────────
# "ranktitan" keeps usage and the audit trail in Rank Titan's database, through
# the internal bridge. "memory" is for a local run with no backend and refuses
# to boot in production: counters would reset on every deploy, handing every
# user their free heatmap back, and differ per instance.
QUOTA_STORE=ranktitan

# ─── OAuth ─────────────────────────────────────────────────────────────────
# Google is used ONLY to learn who the user is: Rank Titan userIds are Google
# subject ids, so this resolves straight to their account. Leave both empty and
# the server still runs — the Connect button simply will not appear and API keys
# keep working.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the access and refresh tokens. At least 32 characters, and NOT the
# development default: the server refuses to boot in production with that one,
# because a predictable key lets anyone mint a token for any account. Changing
# it invalidates every live token at once, which is the lever if one ever leaks.
OAUTH_SIGNING_SECRET=
